{
  "name": "media-center-harvest",
  "version": "1.0.0",
  "description": "Outil de moissonnage d'informations sur les films, séries TV et documentaires (TMDB API + scraping web), intégrés dans Meilisearch.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "harvest": "node dist/index.js",
    "meilisearch:init": "node dist/database/meilisearch/migrate.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "harvester",
    "scraper",
    "tmdb",
    "meilisearch",
    "playwright",
    "films",
    "series"
  ],
  "author": "MediaCenter",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.0",
    "meilisearch": "^0.49.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.8",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
